{% extends 'base.html.twig' %}

{% block title %}Post index{% endblock %}

{% block stylesheets %}
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        background-color: #fafafa;
        padding-top: 60px;
    }

    .navbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        background: white;
        border-bottom: 1px solid #dbdbdb;
        padding: 15px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        z-index: 100;
    }

    .navbar-title {
        font-family: 'Brush Script MT', cursive;
        font-size: 28px;
        font-weight: 400;
    }

    .navbar-actions a {
        margin-left: 15px;
        color: #262626;
        text-decoration: none;
        font-size: 24px;
    }

    .container {
        max-width: 614px;
        margin: 0 auto;
        padding: 20px;
    }

    .post-card {
        background: white;
        border: 1px solid #dbdbdb;
        border-radius: 8px;
        margin-bottom: 24px;
    }

    .post-header {
        padding: 14px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .user-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .user-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 600;
        font-size: 14px;
    }

    .username {
        font-weight: 600;
        color: #262626;
        text-decoration: none;
        font-size: 14px;
    }

    .username:hover {
        text-decoration: underline;
    }

    .post-date {
        font-size: 12px;
        color: #8e8e8e;
        margin-top: 2px;
    }

    .follow-btn {
        color: #0095f6;
        font-weight: 600;
        text-decoration: none;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .follow-btn:hover {
        color: #00376b;
    }

    .post-image {
        width: 100%;
        display: block;
        border-top: 1px solid #efefef;
        border-bottom: 1px solid #efefef;
    }

    .post-actions {
        padding: 8px 16px;
        display: flex;
        gap: 16px;
        align-items: center;
    }

    .action-btn {
        text-decoration: none;
        font-size: 24px;
        display: flex;
        align-items: center;
        gap: 6px;
        color: #262626;
        transition: transform 0.1s;
    }

    .action-btn:hover {
        transform: scale(1.1);
    }

    .action-count {
        font-size: 14px;
        font-weight: 600;
    }

    .post-caption {
        padding: 0 16px 16px;
    }

    .caption-text {
        font-size: 14px;
        color: #262626;
        line-height: 18px;
        margin: 0;
    }

    .no-posts {
        text-align: center;
        padding: 60px 20px;
        color: #8e8e8e;
    }

    .follower-count {
        font-size: 12px;
        color: #8e8e8e;
        margin-left: 4px;
    }

    hr {
        display: none;
    }
</style>
{% endblock %}

{% block body %}
    <nav class="navbar">
        <h1 class="navbar-title">Mi red social</h1>
        <div class="navbar-actions">
            <a href="{{ path('app_post_new') }}" title="Crear nuevo post">➕</a>
            <a href="{{ path('app_story_new') }}" title="Crear historia">📷</a>
        </div>
    </nav>

    <div class="container">
        {% for post in posts %}
            <article class="post-card">
                <div class="post-header">
                    <div class="user-info">
                        <div class="user-avatar">
                            {{ post.author.username|first|upper }}
                        </div>
                        <div>
                            <a href='{{path('app_user_show', {'id': post.author.id})}}' class="username">
                                {{ post.author.username }}
                            </a>
                            {% if app.user.id != post.author.id %}
                                <span class="follower-count">• {{ post.author.followers|length }} seguidores</span>
                            {% endif %}
                            <div class="post-date">
                                {{ post.postdate ? post.postdate|date('d/m/Y H:i') : '' }}
                            </div>
                        </div>
                    </div>
                    {% if app.user.id != post.author.id %}
                        <a href="{{ path('app_user_follow', {'id': post.author.id}) }}" class="follow-btn">
							{% if post.author.followers.contains(app.user) %}
								Siguiendo ✓
							{% else %}
								Seguir
							{% endif %}
						</a>

                    {% endif %}
                </div>

                {% if post.img %}
                    <img src="{{ asset('img/' ~ post.img) }}" class="post-image" alt="{{ post.text }}">
                {% endif %}

                <div class="post-actions">
                    {% if post.likes.contains(app.user) %}
                        <a href="{{ path('app_post_unlike', {'id': post.id}) }}" class="action-btn">
                            💗 <span class="action-count">{{ post.likes|length }}</span>
                        </a>
                    {% else %}
                        <a href="{{ path('app_post_like', {'id': post.id}) }}" class="action-btn">
                            🖤 <span class="action-count">{{ post.likes|length }}</span>
                        </a>
                    {% endif %}

                    {% if post.compartidos.contains(app.user) %}
                        <a href="{{ path('app_post_unshare', {'id': post.id}) }}" class="action-btn">
                            ✅ <span class="action-count">{{ post.compartidos|length }}</span>
                        </a>
                    {% else %}
                        <a href="{{ path('app_post_share', {'id': post.id}) }}" class="action-btn">
                            🔄 <span class="action-count">{{ post.compartidos|length }}</span>
                        </a>
                    {% endif %}
                </div>

                {% if post.text %}
                    <div class="post-caption">
                        <p class="caption-text">
                            <a href='{{path('app_user_show', {'id': post.author.id})}}' class="username">{{ post.author.username }}</a>
                            {{ post.text }}
                        </p>
                    </div>
                {% endif %}
            </article>
        {% else %}
            <div class="no-posts">
                <p>📭 No hay publicaciones aún</p>
            </div>
        {% endfor %}
    </div>
{% endblock %}