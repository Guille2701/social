{% extends 'base.html.twig' %}

{% block title %}Conversación{% endblock %}

{% block body %}
<style>
.chat-container {
    max-width: 700px;
    margin: auto;
    padding: 15px;
    height: 70vh;
    display: flex;
    flex-direction: column;
}
.chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 10px;
    display: flex;
    flex-direction: column;
}
.msg {
    max-width: 70%;
    margin: 5px 0;
    padding: 10px 15px;
    border-radius: 12px;
}
.me {
    align-self: flex-end;
    background-color: #4b88ff;
    color: white;
}
.them {
    align-self: flex-start;
    background-color: #e9e9e9;
}
.chat-form {
    display: flex;
    gap: 10px;
}
.chat-input {
    flex-grow: 1;
}
</style>

<div class="chat-container">

    <div class="chat-messages" id="chatBox">
        {% for msg in messages %}
            <div class="msg {{ msg.sender == app.user ? 'me' : 'them' }}">
                {{ msg.content }}
                <br>
                <small>{{ msg.createdAt|date('H:i') }}</small>
            </div>
        {% endfor %}
    </div>

    <div class="chat-form">
        {{ form_start(form) }}
            {{ form_widget(form.content) }}
            <button class="btn btn-primary">Enviar</button>
        {{ form_end(form) }}
    </div>
</div>

<script>
// Auto scroll al final
var chatBox = document.getElementById('chatBox');
chatBox.scrollTop = chatBox.scrollHeight;
</script>

{% endblock %}
