<!DOCTYPE html>
<link rel="stylesheet" href="{{ asset('css/style.css') }}">
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
        {% endblock %}
    </head>
    <body>
        {% if is_granted('ROLE_USER') %}
            <p>Logged in as {{ app.user.username }}</p>
            <a href="{{ path('app_logout') }}">Logout</a>
            <a href='{{path('app_user_show', {'id': app.user.id})}}'>Perfil</a>
            <a href="{{ path('app_story_index') }}">Stories</a>
            <a href="{{ path('app_post_index') }}">Posts</a>
            <a href="{{ path('friend_index') }}">Amigos</a>
            <a href="{{ path('friend_pending') }}">Invitaciones</a>

            
            
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_admin_dashboard') }}">Admin Dashboard</a>
            {% endif %}
        {% else %}
            <a href="{{ path('app_login') }}">Login</a>
        {% endif %}
        {% block body %}{% endblock %}
    </body>
</html>
